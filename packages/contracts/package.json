{
  "name": "@localfirst/contracts",
  "version": "0.3.0",
  "private": true,
  "description": "Shared Localfirst specification, test, build, and report contracts (schema localfirst/project/v0.2).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

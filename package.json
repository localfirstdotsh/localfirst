{
  "name": "localfirst-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Localfirst.sh — the home of local AI. Phase 1 (P0) agent-native registry.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "pnpm --filter @localfirst/contracts build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:contracts && pnpm -r typecheck",
    "test": "pnpm build:contracts && pnpm -r test",
    "check": "pnpm build:contracts && pnpm -r typecheck && pnpm -r build && pnpm -r test",
    "dev": "pnpm build:contracts && pnpm --parallel --filter @localfirst/backend --filter @localfirst/web dev",
    "dev:backend": "pnpm --filter @localfirst/backend dev",
    "dev:web": "pnpm --filter @localfirst/web dev",
    "worker": "pnpm --filter @localfirst/backend worker",
    "db:generate": "pnpm --filter @localfirst/backend db:generate",
    "db:migrate": "pnpm --filter @localfirst/backend db:migrate",
    "db:seed": "pnpm --filter @localfirst/backend db:seed",
    "test:live": "pnpm --filter localfirstdotsh test:live",
    "test:e2e": "pnpm --filter @localfirst/web test:e2e",
    "verify:environments": "pnpm build && pnpm --filter @localfirst/backend verify:environments",
    "verify:cli-examples": "pnpm build && pnpm --filter @localfirst/backend verify:cli-examples"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  }
}

# Private registry address used by SSR reads and the same-origin browser API/auth/MCP proxy.
LOCALFIRST_API_URL=http://localhost:8787

# Setup command (FRONTEND_PRD 4.2). Set once this deployment has tested the released
# CLI (npm `localfirstdotsh`). Unset deployments offer the source-build command and prerequisites.
# LOCALFIRST_CLI_RELEASED=true
# LOCALFIRST_CLI_VERSION=0.1.0-beta.0
# LOCALFIRST_CLI_SETUP_COMMAND="npx localfirstdotsh@beta mcp add --client claude-code --registry https://api.localfirst.sh"
# Only clients actually tested against the released CLI belong here.
# LOCALFIRST_TESTED_CLIENTS='[{"id":"claude-code","label":"Claude Code","command":"npx localfirstdotsh@beta mcp add --client claude-code --registry https://api.localfirst.sh"}]'

# Public origin of this website, used for canonical URLs and the sitemap.
LOCALFIRST_SITE_URL=http://localhost:3000

# Optional browser download origin; defaults to LOCALFIRST_SITE_URL. For one public
# origin, keep this equal to the website and backend API_BASE_URL/WEBSITE_URL.
# LOCALFIRST_PUBLIC_API_URL=https://localfirst.sh

# Forward each visitor's address to the registry so its rate limits apply per visitor, not to this
# server. Name a header your edge sets or overwrites (never X-Forwarded-For), and add this server's
# network to the API's TRUSTED_PROXIES. Off when unset; nothing changes until both sides are set.
# cf-connecting-ip is only safe behind your own Cloudflare proxy; Render's edge passes a visitor's
# value through, so it stays unset on Render (docs/operations/RUNBOOK.md, "Staging on Render").
# LOCALFIRST_CLIENT_IP_HEADER=cf-connecting-ip

# Component gallery is available automatically in development. Enable explicitly in a preview:
# LOCALFIRST_DESIGN_SYSTEM=true
# LOCALFIRST_DESIGN_SYSTEM_PREVIEW=true # compatibility alias

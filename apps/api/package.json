{
  "name": "@localfirst/api",
  "version": "0.2.0",
  "private": true,
  "description": "Localfirst.sh hosted registry: REST adapter, hosted MCP adapter, and metadata workers.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx --env-file-if-exists=.env src/jobs/worker.ts",
    "worker:start": "node dist/jobs/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/seed.ts",
    "db:auth-schema": "tsx scripts/generate-auth-schema.ts",
    "db:check": "drizzle-kit check",
    "verify:load": "tsx src/verification/load.ts",
    "verify:aggregation": "tsx src/verification/aggregation.ts",
    "verify:restore": "tsx src/verification/restore.ts",
    "verify:mcp-client": "tsx src/verification/mcp-client.ts",
    "verify:browser-consent": "tsx src/verification/browser-consent.ts",
    "verify:local-approval": "tsx src/verification/local-approval.ts",
    "verify:environments": "tsx src/verification/environments.ts",
    "verify:cli-examples": "tsx src/verification/cli-examples.ts",
    "verify:github": "tsx src/verification/github.ts",
    "verify:pitr": "tsx src/verification/pitr.ts",
    "verify:remote-latency": "tsx src/verification/remote-latency.ts",
    "verify:web-experience": "pnpm --filter @localfirst/web test:e2e"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "2.1.4",
    "@localfirst/contracts": "workspace:*",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.9.2",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}

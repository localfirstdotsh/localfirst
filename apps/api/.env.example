# Localfirst backend configuration (BACKEND_PRD section 22.2).
# Copy to .env and fill in. This file must never contain real secrets.

NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8787

# PostgreSQL. Migration credentials are isolated from the API role.
DATABASE_URL=postgres://localhost:5432/localfirst_dev
# MIGRATION_DATABASE_URL=postgres://migrator@localhost:5432/localfirst_dev
DATABASE_POOL_MAX=10

# Public surfaces. The MCP resource (/mcp) and REST resource (/api/v1) are
# distinct token audiences derived from API_BASE_URL.
API_BASE_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000
AUTH_BASE_PATH=/api/auth
# At least 32 characters in production.
AUTH_SECRET=replace-with-a-long-random-development-secret
# TRUSTED_ORIGINS=https://localfirst.sh
# Proxies whose X-Forwarded-For entries are believed when finding the client
# address for rate limits: CIDRs, addresses, or the presets `cloudflare` and
# `private`. Empty means the socket peer is the client and forwarding headers
# are ignored, which is right when nothing sits in front of the server.
# TRUSTED_PROXIES=

# GitHub human sign-in. Minimum identity/email access only; no repo write scope.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional separate credential for bounded public-source ingestion.
GITHUB_INGESTION_TOKEN=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTHORIZATION_CODE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800
APPROVAL_TTL_SECONDS=1800
AUTH_CHECK_CACHE_SECONDS=60

WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5

RATE_LIMIT_PUBLIC_CATALOG_PER_MINUTE=120
RATE_LIMIT_PUBLIC_COMPATIBILITY_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_READS_PER_MINUTE=300
RATE_LIMIT_DRAFTS_PER_HOUR=10
RATE_LIMIT_CONCURRENT_IMPORTS=2
RATE_LIMIT_PUBLICATIONS_PER_DAY=20
RATE_LIMIT_SUBMISSIONS_PER_DAY=100

# Phase gates. The P1 evidence surface is implemented and on by default; each flag stays a
# kill switch that removes discovery and rejects direct calls. Community surfaces are P2; execution remains gated.
FEATURE_GITHUB_IMPORT=true
FEATURE_TEST_DEFINITIONS=true
FEATURE_RESULT_SUBMISSION=true
FEATURE_EVIDENCE_CLASSIFICATION=true
FEATURE_COMMUNITY_NETWORK=true
# Requires community + evidence classification. Human operators apply the versioned independence policy.
FEATURE_INDEPENDENT_VERIFICATION=true
FEATURE_EXECUTABLE_PLANS=false
FEATURE_LEGACY_MCP_SESSIONS=false
FEATURE_DYNAMIC_CLIENT_REGISTRATION=false

# Development-only header identity for local testing. Refused in production.
DEV_AUTH_ENABLED=false
# METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Staging (hosted on Render): see apps/api/.env.staging.example for every value
# staging needs and where it is set. Never put staging values in your local .env.
# -----------------------------------------------------------------------------

# Bounded declarative environments; independent workflow-result write gate.
FEATURE_AGENT_ENVIRONMENTS=false
FEATURE_WORKFLOW_RESULTS=false
FEATURE_FRAMEWORK_ENVIRONMENTS=false

# Localfirst STAGING configuration: what the hosted staging backend needs, and
# where each value lives. Reference only. Never copy this file to `.env`
# or use it locally (it is production mode), and never put a real secret in it.
#
# Where staging runs: Render project `localfirst` -> environment `staging`
# (render.yaml on the `staging` branch), database Neon project
# `localfirstdotsh-staging`. See docs/operations/RUNBOOK.md "Staging on Render".
#
# Render does NOT prompt for the environment-group values when the Blueprint is
# created: open the `localfirst-staging` environment group afterwards and enter
# the "You enter" values there, then redeploy both services.

# --- Set by render.yaml in the `localfirst-staging` group (leave as they are) --
NODE_ENV=production
LOG_LEVEL=info
# Cloudflare edge ranges plus Render's private load balancer.
TRUSTED_PROXIES=cloudflare,private

# --- Generated by Render in the group (do not set or change) ------------------
# Signs sessions and encrypts the stored signing keys. Regenerating it signs
# everyone out and orphans the keys.
# AUTH_SECRET=<generated by Render>
# METRICS_TOKEN=<generated by Render>

# --- You enter in the `localfirst-staging` group -------------------------------
# The staging origin: Render's address until the custom domain is added. Token
# audiences, the auth issuer, and the GitHub callback all derive from it.
API_BASE_URL=https://localfirst-staging-web.onrender.com
# All browser UI and public API/auth/MCP paths use this website origin; the web
# service proxies API requests to the distinct private backend address.
WEBSITE_URL=https://localfirst-staging-web.onrender.com
# Neon `localfirstdotsh-staging`, POOLED string (host ends in `-pooler`). Copy it
# from `.env.local` (`neon env pull`) without the surrounding quotes, and use
# sslmode=verify-full.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full
# The staging-only GitHub OAuth app. Its callback URL must be
#   https://localfirst-staging-web.onrender.com/api/auth/callback/github
GITHUB_CLIENT_ID=<staging OAuth app client id>
GITHUB_CLIENT_SECRET=<staging OAuth app client secret>

# --- You enter on the `localfirst-staging-api` service only --------------------
# Neon `localfirstdotsh-staging`, DIRECT string (no `-pooler`), from
# DATABASE_URL_UNPOOLED in `.env.local`. Used only by the pre-deploy migration.
MIGRATION_DATABASE_URL=postgresql://<role>:<password>@<endpoint>.c-7.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full

# --- Optional, in the group --------------------------------------------------
# Token for bounded public GitHub imports (higher rate limits).
# GITHUB_INGESTION_TOKEN=
# Extra browser origins allowed to call the API, comma-separated, no wildcards.
# TRUSTED_ORIGINS=

# --- Not needed: set by the image or by Render ---------------------------------
# HOST=0.0.0.0 (apps/api/Dockerfile), PORT (Render injects it).
# DEV_AUTH_ENABLED stays unset; production mode refuses it.
# TTLs, worker settings, rate limits and feature flags keep the defaults in
# apps/api/.env.example.
